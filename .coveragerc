[run]
omit =
    tests/*
    */tests/*
    conftest.py
    */conftest.py
    selenium_*_legacy.py
    setup.py
    */migrations/*
    */.venv/*
    */venv/*
source =
    .
[report]
ignore_errors = True
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
